FLASK_ENV=development
PORT=5200
DATABASE_URL=sqlite:///data/app.db
SESSION_SECRET=change-me-in-production
MOCK_SMS_SECRET=dev
SMS_ADAPTER=mock
# SMS_ADAPTER=twilio sends real SMS. All three are then required; startup refuses without them.
# PUBLIC_BASE_URL is the https origin configured in the Twilio console for the number's
# "A message comes in" webhook (<PUBLIC_BASE_URL>/api/hooks/sms/inbound); webhook signatures are
# verified against it, so it has to match exactly. The property's SMS number (Admin > Settings)
# must be the Twilio number in E.164.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# PUBLIC_BASE_URL=https://example.up.railway.app
PMS_TICK_SECONDS=90
START_WORKER=1
CORS_ORIGIN=http://localhost:5173
# Unauthenticated simulator routes (/api/dev/*): local development only. They list
# every guest at every property, so they stay off unless this is explicitly 1, and
# never register at all when FLASK_ENV=production.
# ENABLE_DEV_ENDPOINTS=1
# Set to 1 only for an entrypoint that runs Flask's auto-reloader (run.py / dev_start.py set it
# for you). It tells create_app that a parent monitor process exists, so the job worker starts in
# the reloader child only. Leave unset under gunicorn.
USE_RELOADER=0
# Session cookie `Secure` flag. Unset = secure in production, not in development.
# SESSION_COOKIE_SECURE=1
