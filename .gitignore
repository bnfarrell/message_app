# Only regenerated, machine-specific, or secret things are ignored. Everything else —
# the SDD audit trail under .superpowers/, the dummy seed database, the mockup sources —
# is committed on purpose: the data is all fixture data.

# Dependency trees. Regenerated by `npm ci` and `pip install`; platform-specific binaries,
# and .venv bakes absolute Windows paths that are wrong everywhere else.
.venv/
node_modules/

# Isolated git worktrees for in-progress feature branches (superpowers:using-git-worktrees).
.worktrees/

# Build and tool caches, regenerated on every run.
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.playwright-mcp/

# Real secrets. .env.example is committed; .env is not.
.env
