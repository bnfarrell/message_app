+    expect(container.querySelectorAll('[data-testid="bar"]')).toHaveLength(0)
+  })
+
+  it('labels each bar for assistive tech and hover', () => {
+    render(<BarChart buckets={BUCKETS} labelOf={(b) => `${b.hour}:00 · ${b.count} messages`} />)
