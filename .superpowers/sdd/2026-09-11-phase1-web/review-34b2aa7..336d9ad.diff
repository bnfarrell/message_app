+import { render, screen } from '@testing-library/react'
+import { describe, expect, it } from 'vitest'
+import { BarChart } from './BarChart'
+
+const BUCKETS = [
+  { hour: 0, count: 2 },
+  { hour: 1, count: 0 },
+  { hour: 18, count: 31 },
+  { hour: 19, count: 14 },
